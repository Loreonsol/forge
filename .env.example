# Forge IdeaEngine configuration
# Copy to .env.local (Next.js) or export in your shell.

# Engine selection: auto (default) | mock | llm
# auto → LLM when FORGE_LLM_API_KEY is set, otherwise mock
FORGE_ENGINE=auto

# Required for LLM mode (OpenAI or any OpenAI-compatible provider, including xAI)
FORGE_LLM_API_KEY=

# OpenAI-compatible Chat Completions base URL (no trailing path beyond /v1)
# OpenAI (default): https://api.openai.com/v1
# xAI Grok:         https://api.x.ai/v1
FORGE_LLM_BASE_URL=https://api.openai.com/v1

# Model id
# OpenAI default: gpt-4o-mini
# xAI examples:   grok-2-latest  (or check https://docs.x.ai for current ids)
FORGE_LLM_MODEL=gpt-4o-mini

# Optional: one-click Deploy with Vercel (Summary / Scaffold tabs)
# When set, POST /api/runs/:id/deploy uploads the scaffold via Vercel Deployments API.
# Without these, the UI still offers download ZIP + `npx vercel` / vercel.com/new.
VERCEL_TOKEN=
# Optional team / project targeting
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
